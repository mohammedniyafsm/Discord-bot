# Discord Application Credentials (from Discord Developer Portal)
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_PUBLIC_KEY=your_discord_public_key_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_APPLICATION_ID=your_discord_application_id_here

# Database (Prisma)
# Example for Neon/Supabase PostgreSQL
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# NextAuth Configuration
# Generate a random string (e.g. using `openssl rand -base64 32`)
NEXTAUTH_SECRET=your_random_secret_string_here

# The base URL of your application.
# Use your ngrok URL for local development (e.g. https://your-ngrok.app)
NEXTAUTH_URL=http://localhost:3000