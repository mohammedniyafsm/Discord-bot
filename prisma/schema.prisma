generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Server {
  id               String   @id @default(cuid())
  guildId          String   @unique
  guildName        String
  notifyChannelId  String
  mirrorWebhookUrl String
  ownerId          String
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CommandConfig {
  id           String   @id @default(cuid())
  guildId      String
  commandName  String
  enabled      Boolean  @default(true)
  replyMessage String   @default("")
  updatedAt    DateTime @updatedAt

  @@unique([guildId, commandName])
}

model InteractionLog {
  id                   String   @id
  discordInteractionId String   @unique
  commandName          String
  guildId              String?
  userId               String
  username             String
  inputText            String?
  responseSent         String
  mirrored             Boolean  @default(false)
  status               String
  errorMessage         String?
  createdAt            DateTime @default(now())
}


